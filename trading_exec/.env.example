# Add these to the repo-root .env (which is gitignored). DHAN_* are already there.

# --- alerts: Telegram (create a bot with @BotFather, then message it once and read chat id) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# --- alerts: email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password        # Gmail: an App Password, not your login password
SMTP_TO=you@gmail.com

# --- Stage C only. Stage A has no order-capable code at all. ---
ENABLE_LIVE=false
