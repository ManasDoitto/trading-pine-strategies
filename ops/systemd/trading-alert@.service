[Unit]
Description=Telegram alert for a failed trading unit (%i)
[Service]
Type=oneshot
User=trading
EnvironmentFile=/opt/trading/repo/.env
ExecStart=/opt/trading/repo/.venv/bin/python -c "import os,urllib.request,json,sys; t=os.environ.get('TELEGRAM_BOT_TOKEN'); c=os.environ.get('TELEGRAM_CHAT_ID'); u=f'https://api.telegram.org/bot{t}/sendMessage' if t else None; (urllib.request.urlopen(urllib.request.Request(u, data=json.dumps({'chat_id': c, 'text': '[systemd] unit failed: %i'}).encode(), headers={'Content-Type':'application/json'}), timeout=15) if u and c else None)"
