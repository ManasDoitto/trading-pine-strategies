//@version=5
strategy("Strat 2: 5m Liquidity Sweep + Reclaim", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// Parameters
lookback = input.int(20, "Lookback for Swing Low/High")
reclaim_len = input.int(3, "Reclaim Length")
sl_atr_mult = input.float(1.5, "Stop Loss ATR Multiplier")
tp_atr_mult = input.float(3.0, "Take Profit ATR Multiplier")

// Indicators
atr = ta.atr(14)
swing_low = ta.lowest(low, lookback)
swing_high = ta.highest(high, lookback)

// Sweep Logic
// Price goes below previous lookback low, but closes above it (reclaim)
prev_low = swing_low[1]
prev_high = swing_high[1]

sweep_low = low < prev_low and close > prev_low
sweep_high = high > prev_high and close < prev_high

// Entry Logic
if (sweep_low)
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", "Long", stop=close - atr * sl_atr_mult, limit=close + atr * tp_atr_mult)

if (sweep_high)
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", "Short", stop=close + atr * sl_atr_mult, limit=close - atr * tp_atr_mult)
